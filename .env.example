# =============================================================================
# AI YouTube Auto Clipper — Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Domain & Networking (Production)
# -----------------------------------------------------------------------------
DOMAIN=localhost
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_USER=clipuser
POSTGRES_PASSWORD=clippass_change_in_production
POSTGRES_DB=clipdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://clipuser:clippass_change_in_production@postgres:5432/clipdb

# -----------------------------------------------------------------------------
# Queue & Cache (Redis 7)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=redispass_change_in_production
REDIS_PORT=6379
REDIS_URL=redis://:redispass_change_in_production@redis:6379

# -----------------------------------------------------------------------------
# Authentication & JWT
# -----------------------------------------------------------------------------
# IMPORTANT: Generate strong random secrets for production!
JWT_SECRET=replace-with-a-random-32-char-secret-key-12345
JWT_REFRESH_SECRET=replace-with-another-random-32-char-secret-67890
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# -----------------------------------------------------------------------------
# AI Clip Detection (Gemini / OpenAI)
# -----------------------------------------------------------------------------
# Choose: "gemini" or "openai"
AI_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration (optional if using Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Speech-To-Text / Whisper Configuration
# -----------------------------------------------------------------------------
# Models: tiny, base, small, medium, large-v3
# Recommended for standard CPU VPS: "base" or "small" (fast & low RAM)
# Recommended for GPU VPS / high accuracy: "large-v3"
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# -----------------------------------------------------------------------------
# Storage & Cleanup
# -----------------------------------------------------------------------------
STORAGE_LOCAL_PATH=/app/storage
STORAGE_TEMP_RETENTION_HOURS=72
CLEANUP_INTERVAL_HOURS=6

# -----------------------------------------------------------------------------
# Media Processing (FFmpeg & yt-dlp)
# -----------------------------------------------------------------------------
FFMPEG_THREADS=2
CLIP_MAX_CONCURRENT=2
YTDLP_MAX_DURATION=21600
YTDLP_MAX_QUALITY=1080p
