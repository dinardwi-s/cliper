# =============================================================================
# AI YouTube Auto Clipper — API (NestJS) Dockerfile
# =============================================================================
# Serves REST + WebSocket. Stateless — safe to scale horizontally.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Dependencies
# ---------------------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app

RUN corepack enable pnpm && corepack prepare pnpm@latest --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/

RUN pnpm install --frozen-lockfile --prod=false

# ---------------------------------------------------------------------------
# Stage 2: Builder
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable pnpm && corepack prepare pnpm@latest --activate

COPY --from=deps /app/node_modules ./node_modules

COPY . .
RUN pnpm install --frozen-lockfile --prod=false

# Generate Prisma client
RUN pnpm --filter @clip-project/api prisma:generate

# Build the NestJS app
RUN pnpm --filter @clip-project/api build

# ---------------------------------------------------------------------------
# Stage 3: Runner
# ---------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

# Install system dependencies for bcrypt native addon
RUN apk add --no-cache dumb-init

RUN addgroup --system --gid 1001 clipgroup && \
    adduser --system --uid 1001 clipuser && \
    chown -R clipuser:clipgroup /app

RUN corepack enable pnpm && corepack prepare pnpm@latest --activate

COPY --from=builder /app/apps/api/package.json apps/api/
COPY --from=builder /app/packages/shared/package.json packages/shared/
COPY --from=builder /app/package.json \
     /app/pnpm-workspace.yaml \
     /app/pnpm-lock.yaml ./

# Production node_modules (for runtime deps like @nestjs/*, prisma, etc.)
RUN pnpm install --frozen-lockfile --prod=false

# Copy Prisma artifacts (generated client + migrations)
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
RUN pnpm --filter @clip-project/api prisma:generate --schema prisma/schema.prisma

# Copy build output
COPY --from=builder /app/apps/api/dist ./apps/api/dist

USER clipuser

EXPOSE 3001

ENV NODE_ENV=production
ENV PORT=3001

ENTRYPOINT ["dumb-init", "--"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

CMD ["pnpm", "--filter", "@clip-project/api", "start:prod"]
