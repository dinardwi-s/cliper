# =============================================================================
# AI YouTube Auto Clipper — Web (Next.js 15) Dockerfile
# =============================================================================
# Multi-stage build targeted for production.
# Dev environment uses docker-compose with bind mounts + hot reload.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Dependencies
# ---------------------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app

# Install pnpm globally
RUN corepack enable pnpm && corepack prepare pnpm@latest --activate

# Copy workspace config and lockfile for install
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/

# Install dependencies (all workspaces)
RUN pnpm install --frozen-lockfile --prod=false

# ---------------------------------------------------------------------------
# Stage 2: Builder
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable pnpm && corepack prepare pnpm@latest --activate

# Copy installed dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY . .
RUN pnpm install --frozen-lockfile --prod=false

# Set build-time env vars (NEXT_PUBLIC_* embedded at build time)
ARG NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
ARG NEXT_PUBLIC_WS_URL=ws://localhost:4000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}

# Build the web app (includes type checking)
RUN pnpm --filter @clip-project/web build

# ---------------------------------------------------------------------------
# Stage 3: Runner (production)
# ---------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 clipgroup && \
    adduser --system --uid 1001 clipuser && \
    chown -R clipuser:clipgroup /app

# Install only production dependencies
RUN corepack enable pnpm && corepack prepare pnpm@latest --activate

COPY --from=builder /app/apps/web/package.json apps/web/
COPY --from=builder /app/packages/shared/package.json packages/shared/
COPY --from=builder /app/node_modules node_modules

# Copy build output
COPY --from=builder /app/apps/web/.next apps/web/.next
COPY --from=builder /app/apps/web/next.config.js apps/web/
COPY --from=builder /app/apps/web/public apps/web/public
COPY --from=builder /app/package.json ./

USER clipuser

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["pnpm", "--filter", "@clip-project/web", "start"]
