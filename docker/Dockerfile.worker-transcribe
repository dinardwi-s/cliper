FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable pnpm && corepack prepare pnpm@latest --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --prod=false

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable pnpm && corepack prepare pnpm@latest --activate
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm install --frozen-lockfile --prod=false
RUN pnpm --filter @clip-project/api prisma:generate
RUN pnpm --filter @clip-project/api build

FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl ffmpeg dumb-init nodejs npm && rm -rf /var/lib/apt/lists/*
RUN npm install -g corepack && corepack enable pnpm && corepack prepare pnpm@9.15.4 --activate
RUN pip install --no-cache-dir faster-whisper numpy
RUN groupadd --system --gid 1001 clipgroup && useradd --system --uid 1001 --gid clipgroup clipuser
COPY --from=builder /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
COPY --from=builder /app/apps/api/package.json apps/api/
COPY --from=builder /app/packages/shared/package.json packages/shared/
COPY --from=builder /app/apps/api/prisma apps/api/prisma/
COPY --from=builder /app/apps/api/python apps/api/python/
COPY --from=builder /app/apps/api/dist apps/api/dist/
RUN pnpm install --frozen-lockfile --prod=false && pnpm --filter @clip-project/api prisma:generate --schema prisma/schema.prisma
RUN chown -R clipuser:clipgroup /app
USER clipuser
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/api/dist/workers/transcribe.worker.js"]
